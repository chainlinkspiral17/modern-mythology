# Godot
godot/.godot/
godot/*.import
godot/**/*.import
*.translation

# Godot export
godot/export_presets.cfg

# Large 3D model binaries — kept local (sourced from Drive), not in git
godot/assets/models/*.glb
godot/assets/models/*.gltf
godot/assets/models/*.bin

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
.vscode/

# Runway-generated videos — curate manually; commit a piece by piece
godot/assets/video/generated/

# Sky HDRIs — large binaries, kept local
godot/assets/sky/*.hdr
godot/assets/sky/*.exr
godot/assets/sky/*.png
godot/assets/sky/*.jpg

# Comic images live on Google Drive (godot/tools/comic/comic_drive.py, the
# inspector's SAVE); git keeps godot/tools/comic/drive_manifest.json.
# Images git already tracks stay tracked; new ones are not added.
godot/assets/comic/**/*.png
godot/assets/comic/**/*.jpg
godot/assets/comic/**/*.jpeg
godot/assets/comic/**/*.webp
lore/drift_wood/refs/**/*.png
lore/drift_wood/refs/**/*.jpg
lore/drift_wood/refs/**/*.jpeg
lore/drift_wood/refs/**/*.webp
