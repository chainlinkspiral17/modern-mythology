# Godot
godot/.godot/
godot/*.import
godot/**/*.import
*.translation

# Godot export
godot/export_presets.cfg

# Large 3D model binaries — kept local (sourced from Drive), not in git
godot/assets/models/*.glb
godot/assets/models/*.gltf
godot/assets/models/*.bin

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
.vscode/

# Runway-generated videos — curate manually; commit a piece by piece
godot/assets/video/generated/

# Sky HDRIs — large binaries, kept local
godot/assets/sky/*.hdr
godot/assets/sky/*.exr
godot/assets/sky/*.png
godot/assets/sky/*.jpg

# API key files for godot/tools/*_render.py / meshy_pipeline.py — never commit
godot/tools/.runway_key
godot/tools/.meshy_key
godot/tools/.google_key
godot/tools/.*_key

# Meshy pipeline concept-art candidates — curate manually; the chosen GLB
# lands in assets/3d/... and IS committed. The manifest (the run's names)
# and each character's chosen front image ARE tracked since 2026-09-26,
# so a fresh clone brings Hero Studio back the way it was left.
godot/assets/concept/meshy/*
!godot/assets/concept/meshy/manifest.json
!godot/assets/concept/meshy/*/
godot/assets/concept/meshy/*/*
!godot/assets/concept/meshy/*/front.png
!godot/assets/concept/meshy/*/front.jpg
