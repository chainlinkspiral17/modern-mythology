# Godot
godot/.godot/
godot/*.import
godot/**/*.import
*.translation

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
.vscode/

# Runway-generated videos — curate manually; commit a piece by piece
godot/assets/video/generated/
builds/

# Meshy 3D-gen API key (never commit) + raw downloaded GLB staging
godot/tools/.meshy_key
godot/assets/3d/meshy/**/*.glb

# art pipeline
godot/tools/art/.image_key
godot/tools/art/*.config.json
**/*.src.png
# Godot 4.6 UID sidecars + textures extracted by GLB import — both
# regenerate on any machine's import; never commit them.
*.uid
godot/assets/3d/characters/heroes/*_[0-9].jpg
godot/assets/3d/characters/heroes/*_Image_[0-9].jpg
godot/assets/3d/characters/heroes/*_normal.png

# THE LENS (2026-09-15): contact-sheet frames travel on the orphan
# branch qa/contact (tools/contact_push.sh), never on the working branch.
godot/qa/contact/

# Hero Studio (ported from the meshy branch 2026-09-30). API key files
# for meshy_pipeline.py — never commit.
godot/tools/.runway_key
godot/tools/.google_key
godot/tools/.*_key
# Concept-art candidates stay local; the manifest (the run's names) and
# each character's chosen front image are tracked, so a fresh clone
# comes back the way the tool was left. The GLBs in assets/3d/... are
# committed.
godot/assets/concept/meshy/*
!godot/assets/concept/meshy/manifest.json
!godot/assets/concept/meshy/*/
godot/assets/concept/meshy/*/*
!godot/assets/concept/meshy/*/front.png
!godot/assets/concept/meshy/*/front.jpg
