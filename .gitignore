# Godot
godot/.godot/
godot/*.import
godot/**/*.import
*.translation

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
.vscode/

# Runway-generated videos — curate manually; commit a piece by piece
godot/assets/video/generated/
builds/

# Meshy 3D-gen API key (never commit) + raw downloaded GLB staging
godot/tools/.meshy_key
godot/assets/3d/meshy/**/*.glb

# art pipeline
godot/tools/art/.image_key
godot/tools/art/*.config.json
**/*.src.png
# Godot 4.6 UID sidecars + textures extracted by GLB import — both
# regenerate on any machine's import; never commit them.
*.uid
godot/assets/3d/characters/heroes/*_[0-9].jpg
godot/assets/3d/characters/heroes/*_Image_[0-9].jpg
godot/assets/3d/characters/heroes/*_normal.png

# THE LENS (2026-09-15): contact-sheet frames travel on the orphan
# branch qa/contact (tools/contact_push.sh), never on the working branch.
godot/qa/contact/

# Hero Studio (ported from the meshy branch 2026-09-30). API key files
# for meshy_pipeline.py — never commit.
godot/tools/.runway_key
godot/tools/.google_key
godot/tools/.*_key
# your own Google OAuth client for rclone (drive_setup.sh --client)
godot/tools/.gdrive_client
# Models and pictures live on GOOGLE DRIVE, not in git (2026-09-30, the
# user: "I don't want to crowd up git with large models and files").
# Hero Studio's SAVE uploads them (rclone, godot/tools/drive_setup.sh)
# and commits godot/tools/drive_manifest.json — size + md5 of each — so
# `meshy_pipeline.py drive-pull` fetches what a checkout lacks. Models
# git already tracked stay tracked; new ones are ignored.
godot/assets/3d/characters/heroes/*.glb
godot/assets/3d/characters/demons/*.glb
godot/assets/3d/props/*.glb
godot/assets/concept/meshy/*
!godot/assets/concept/meshy/manifest.json
# PAINT OR PASS generations + composites (Google Drive, not git)
godot/assets/concept/scenes/

# The opening movie and any other video: Google Drive, not git
# (godot/tools/install_intro_video.sh; drive-pull restores it)
godot/assets/video/**/*.ogv
godot/assets/video/**/*.ogv.import

# Voice lines and Drive audio: Google Drive, not git (2026-10-01).
# import_voice_dropins.sh writes voice/, Hero Studio's AUDIO page writes
# drive/; drive-pull restores both. The vol5 lines committed in June stay
# tracked (ignore rules never untrack a file).
godot/assets/audio/voice/**/*.mp3
godot/assets/audio/voice/**/*.ogg
godot/assets/audio/voice/**/*.wav
godot/assets/audio/voice/**/*.webm
godot/assets/audio/voice/**/*.import
godot/assets/audio/drive/

# Locale GLBs are build artifacts (Blender, per machine): godot/tools/blender
# builds them; the Deck and this checkout each keep their own.
godot/assets/3d/locales/*.glb
godot/assets/3d/locales/*.glb.import
