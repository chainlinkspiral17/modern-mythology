  },
  {
   "t": "narrate",
   "text": "Faust stands up and looks away from the painting.",
   "voice": "assets/audio/voice/vol1_ch2_painting_b/017.mp3"
  },
  {
   "t": "say",
   "char": "Faust",
   "expr": "neutral",
   "text": "Bladder is bursting. (as he pees) Oh — what a wonderful tea party.",
