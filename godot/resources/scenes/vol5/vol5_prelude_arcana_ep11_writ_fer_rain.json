    {
      "t": "say",
      "char": "Elicia",
      "expr": "neutral",
      "text": "Two poems. One about weather on skin. One about a middle school with geniuses in the walls.",
      "role": "— voice-over —"
    },
    {
      "t": "say",
      "char": "Elicia",
      "expr": "neutral",
      "text": "Short. Turn it up.",
      "role": "— voice-over —"
    },
    {
      "t": "hide",
      "pos": "center"
    },
    {
      "t": "narrate",
      "text": "Percussive taunt on a face long gaunt\nBeading up eyelash soft focus grill\nHold that thought hover that drop\nStrain every eye muscle."
    },
    {
      "t": "narrate",
      "text": "Soft water slicks sorry skin burdened with troubles\nPrickle tickle tense incision\nCold fluid motion cutting surface tension\nTread lightly lift gently collapse."
    },
    {
      "t": "narrate",
      "text": "Excelsior Middle\nSay what you will about\nWhat brung you here."
    },
    {
      "t": "narrate",
      "text": "Tandem sideshow conjoined genii\nBad habit of finishing each other’s-\nJung, Freud, Kant, Tesla, Einstein-\nSentence."
    },
    {
      "t": "show",
      "char": "elicia",
      "expr": "neutral",
      "pos": "center"
    },
    {
      "t": "say",
      "char": "Elicia",
      "expr": "neutral",
      "text": "Sentence. Goodnight.",
      "role": "— voice-over —"
    },
