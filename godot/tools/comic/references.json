{
  "_comment": "Reference-image registry for strip generation. Each entry: id, kind (character|location|era|objects|strip|concept), tags (hero ids, location ids, era ids, object keywords), file (repo path) and/or url / runway_task_id, status (approved|draft|missing), notes. comic_tool.py refs {list|add|approve|reject|sync|suggest} manages it; strip-prompts attaches up to N approved refs per strip by tag relevance unless the strip's own 'references' block overrides. Rendered sheets land in godot/assets/comic/vol10/sheets/<id>.png and `refs sync` picks them up.",
  "policy": {
    "max_refs": {
      "runway": 3,
      "google": 4
    },
    "weights": {
      "character": 3,
      "location": 2,
      "era": 1,
      "object": 1,
      "strip_same_arc": 1
    },
    "require_approved": true,
    "prefer_kinds": [
      "character",
      "location",
      "era",
      "objects",
      "strip"
    ]
  },
